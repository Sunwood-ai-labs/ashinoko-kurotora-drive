{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course asset index v1",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "lengthM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "revision": {
      "type": "string"
    }
  }
}
