{
  "name": "ashinoko-kurotora-drive",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/validate.mjs && npm run test:course && npm run test:loading && npm run test:graphics && npm run test:detail && npm run course:validate && npm run course:pin && npm run test:import && npm run docs:check",
    "start": "python3 -m http.server 8000 --directory dist",
    "test:course": "node scripts/test-course-contract.mjs dist",
    "test:loading": "node scripts/test-loading-interruption.mjs dist",
    "test:graphics": "node scripts/test-graphics-error.mjs dist",
    "test:detail": "node scripts/test-detail-filter.mjs dist",
    "course:validate": "node scripts/course-pack.mjs --assets-dir dist/assets --runtime dist/course-loader.mjs",
    "course:checksums": "node scripts/course-pack.mjs --assets-dir dist/assets --runtime dist/course-loader.mjs --write",
    "checksums": "node tools/checksums.mjs",
    "course:pin": "node scripts/sync-course.mjs --check",
    "course:import": "node scripts/sync-course.mjs",
    "test:import": "node scripts/test-course-import.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Ashinoko GT browser driving game with a pinned, independently maintained course pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunwood-ai-labs/ashinoko-kurotora-drive.git"
  }
}
